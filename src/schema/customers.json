{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "id": "http://Customers",
    "title": "Customers",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "created": {
            "type": "number"
        },
        "status": {
            "type": "string"
        },
        "threeWordsUbication": {
            "type": "string"
        },
        "contact": {
            "type": "object",
            "title": "Contact",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                },
                "lastName": {
                    "type": "string"
                },
                "address": {
                    "type": "string"
                },
                "phoneNumber": {
                    "type": "string"
                },
                "ubication": {
                    "type": "object",
                    "title": "Ubication",
                    "additionalProperties": false,
                    "properties": {
                        "latitude": {
                            "type": "string"
                        },
                        "longitude": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "aval": {
            "type": "object",
            "title": "Aval",
            "additionalProperties": false,
            "properties": {
                "customerId": {
                    "type": "string",
                    "description": "Solo si el aval ya es un cliente registrado (se eligio del buscador)"
                },
                "contact": {
                    "$ref": "#/properties/contact"
                }
            },
            "required": [
                "contact"
            ],
            "description": "Aval del cliente: solo informacion de respaldo (contacto de la persona que lo avala). Opcional; el backend lo guarda al crear el cliente"
        },
        "creditorCompanyId": {
            "type": "string"
        },
        "userId": {
            "type": "string"
        }
    },
    "required": [
        "creditorCompanyId",
        "userId",
        "threeWordsUbication",
        "contact"
    ]
}
