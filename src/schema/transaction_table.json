{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "id": "http://TransactionTable",
    "title": "TransactionTable",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "_id": {
            "type": "string"
        },
        "createdAt": {
            "type": "string"
        },
        "updatedAt": {
            "type": "string"
        },
        "transactionType": {
            "type": "string"
        },
        "transactionSubType": {
            "type": "string"
        },
        "total": {
            "type": "number"
        },
        "status": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "currency": {
            "type": "string"
        },
        "creditIdSource": {
            "type": "string"
        },
        "creditorCompanyId": {
            "type": "string"
        },
        "creditBasicInfo": {
            "type": "object",
            "title": "CreditBasicInfo",
            "additionalProperties": false,
            "required": [
                "creditId",
                "total",
                "amountPaid",
                "amountDue"
            ],
            "properties": {
                "creditId": {
                    "type": "string"
                },
                "total": {
                    "type": "number"
                },
                "amountPaid": {
                    "type": "number"
                },
                "amountDue": {
                    "type": "number"
                }
            },
            "description": "Info del credito enlazado (creditInfo[0] del join en el backend): trae el _id real del credito para poder navegar de la transaccion a su credito"
        },
        "sourceAccount": {
            "type": "object",
            "title": "SourceAccount",
            "additionalProperties": false,
            "required": [
                "walletId"
            ],
            "properties": {
                "accountNumber": {
                    "type": "string"
                },
                "walletId": {
                    "type": "string"
                }
            }
        },
        "destinationAccount": {
            "type": "object",
            "title": "DestinationAccount",
            "additionalProperties": false,
            "required": [
                "walletId"
            ],
            "properties": {
                "accountNumber": {
                    "type": "string"
                },
                "walletId": {
                    "type": "string"
                }
            }
        }
    }
}
