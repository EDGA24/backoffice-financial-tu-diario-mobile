{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://SearchCreditsRequest",
  "title": "SearchCreditsRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "filtersItems": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "creditorCompanyId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "customerId": {
          "type": "string"
        },
        "status": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transactionStatus": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdRangeDate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startDate": {
              "type": "number"
            },
            "endDate": {
              "type": "number"
            }
          }
        }
      },
      "required": [
        "creditorCompanyId"
      ]
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pageNumber": {
          "type": "number"
        },
        "limit": {
          "type": "number"
        }
      },
      "required": [
        "pageNumber",
        "limit"
      ]
    }
  },
  "required": [
    "filtersItems",
    "pagination"
  ]
}