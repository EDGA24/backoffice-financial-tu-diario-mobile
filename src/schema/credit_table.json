{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "id": "http://CreditTable",
    "title": "CreditTable",
    "type": "object",
    "additionalProperties": false,
    "definitions": {
        "chargeRules": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "chargeFrequency": {
                    "type": "string"
                },
                "chargePeriods": {
                    "type": "number"
                },
                "renovationPeriod": {
                    "type": "number"
                },
                "comissionRate": {
                    "type": "number"
                },
                "chargeDay": {
                    "type": "string"
                },
                "firstCharge": {
                    "type": "boolean"
                },
                "latePaymentCharge": {
                    "type": "number"
                }
            },
            "required": [
                "chargeFrequency",
                "chargePeriods",
                "renovationPeriod",
                "comissionRate"
            ]
        },
        "customerBasicInfo": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "customerId": {
                    "type": "string"
                },
                "fullName": {
                    "type": "string"
                },
                "phoneNumber": {
                    "type": "string"
                }
            },
            "required": [
                "customerId",
                "fullName",
                "phoneNumber"
            ]
        },
        "employeeBasicInfo": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "userId": {
                    "type": "string"
                },
                "fullName": {
                    "type": "string"
                },
                "phoneNumber": {
                    "type": "string"
                }
            },
            "required": [
                "userId",
                "fullName",
                "phoneNumber"
            ]
        },
        "lastPayment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "createdAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "transactionStatus": {
                    "type": "string"
                },
                "total": {
                    "type": "number"
                }
            },
            "required": [
                "createdAt",
                "transactionStatus",
                "total"
            ]
        }
    },
    "properties": {
        "_id": {
            "type": "string"
        },
        "startDateChargeConfig": {
            "type": "string",
            "format": "date-time"
        },
        "admissionDate": {
            "type": "string",
            "format": "date-time"
        },
        "expirationDate": {
            "type": "string",
            "format": "date-time"
        },
        "lastPaymentDateApproved": {
            "type": "string",
            "format": "date-time"
        },
        "changeDateStatus": {
            "type": "string",
            "format": "date-time"
        },
        "creditAmount": {
            "type": "number"
        },
        "amountDue": {
            "type": "number"
        },
        "amountPaid": {
            "type": "number"
        },
        "creditAmountWithMoratory": {
            "type": "number"
        },
        "amountMoratory": {
            "type": "number"
        },
        "amountPaidMoratory": {
            "type": "number"
        },
        "fixedCharge": {
            "type": "number"
        },
        "status": {
            "type": "string",
            "enum": [
                "charge_process",
                "slow_pay",
                "paid",
                "reestructured"
            ],
            "description": "Coincide con CreditStatusEnum del backend: minusculas, guion bajo, y reestructured con doble e"
        },
        "creationStatus": {
            "type": "string",
            "enum": [
                "new",
                "renewed"
            ]
        },
        "transactionStatus": {
            "type": "string"
        },
        "chargeRules": {
            "$ref": "#definitions/chargeRules"
        },
        "userId": {
            "type": "string"
        },
        "creditorCompanyId": {
            "type": "string"
        },
        "transactionId": {
            "type": "string"
        },
        "customerId": {
            "type": "string"
        },
        "customerBasicInfo": {
            "$ref": "#definitions/customerBasicInfo"
        },
        "employeeBasicInfo": {
            "$ref": "#definitions/employeeBasicInfo"
        },
        "lastPayment": {
            "$ref": "#definitions/lastPayment"
        }
    },
    "required": [
        "_id",
        "startDateChargeConfig",
        "admissionDate",
        "expirationDate",
        "creditAmount",
        "creditAmountWithMoratory",
        "fixedCharge",
        "status",
        "chargeRules",
        "userId",
        "creditorCompanyId",
        "transactionId",
        "customerId"
    ]
}
