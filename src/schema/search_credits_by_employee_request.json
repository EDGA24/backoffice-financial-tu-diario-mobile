{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "id": "http://SearchCreditsByEployeeRequest",
    "title": "SearchCreditsByEployeeRequest",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "filtersItems": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "creditorCompanyId": {
                    "type": "string"
                },
                "userId": {
                    "type": "string"
                },
                "generalSearch": {
                    "type": "string"
                },
                "chargeFrequency": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "creditId": {
                    "type": "string",
                    "description": "Navegacion desde Transacciones hacia el credito relacionado: se manda solo uno de los dos, nunca ambos (ver UserRoleCatalogs.tsx en el backend)"
                },
                "transactionId": {
                    "type": "string"
                }
            },
            "required": [
                "creditorCompanyId",
                "userId"
            ]
        },
        "pagination": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "pageNumber": {
                    "type": "number"
                },
                "limit": {
                    "type": "number"
                }
            },
            "required": [
                "pageNumber",
                "limit"
            ]
        }
    },
    "required": [
        "filtersItems",
        "pagination"
    ]
}
